          "type": "object",
          "required": true,
          "properties": {
            "componentName": {
              "type": "string",
              "required": true,
              "minLength": 1
            },
            "projectName": {
              "type": "string",
              "required": true,
              "minLength": 1
            }
          }
        }
      }
