{
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "required": true,
      "default": "openchoreo.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "required": true,
      "default": "ProjectRelease"
    },
    "metadata": {
      "type": "object",
      "required": false,
      "properties": {
        "annotations": {
          "type": "object",
          "required": false,
          "preserveUnknownFields": true
        },
        "creationTimestamp": {
          "type": "string",
          "required": false
        },
        "labels": {
          "type": "object",
          "required": false,
          "preserveUnknownFields": true
        },
        "name": {
          "type": "string",
          "required": false
        },
        "namespace": {
          "type": "string",
          "required": false
        },
        "uid": {
          "type": "string",
          "required": false
        }
      }
    },
    "spec": {
      "type": "object",
      "required": false,
      "properties": {
        "owner": {
          "type": "object",
          "required": true,
          "properties": {
            "projectName": {
              "type": "string",
              "required": true,
              "minLength": 1
            }
          }
        },
        "parameters": {
          "type": "object",
          "required": false,
          "preserveUnknownFields": true
        },
        "projectType": {
          "type": "object",
          "required": true,
          "properties": {
            "kind": {
              "type": "string",
              "required": true,
              "enum": [
                "ProjectType",
                "ClusterProjectType"
              ]
            },
            "name": {
              "type": "string",
              "required": true,
              "minLength": 1
            },
            "spec": {
              "type": "object",
              "required": true,
              "properties": {
                "environmentConfigs": {
                  "type": "object",
                  "required": false,
                  "properties": {
                    "openAPIV3Schema": {
                      "type": "object",
                      "required": false,
                      "preserveUnknownFields": true
                    }
                  }
                },
                "parameters": {
                  "type": "object",
                  "required": false,
                  "properties": {
                    "openAPIV3Schema": {
                      "type": "object",
                      "required": false,
                      "preserveUnknownFields": true
                    }
                  }
                },
                "resources": {
                  "type": "array",
                  "required": true,
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "forEach": {
                        "type": "string",
                        "required": false,
                        "pattern": "^\\$\\{[\\s\\S]+\\}\\s*$"
                      },
                      "id": {
                        "type": "string",
                        "required": true,
                        "minLength": 1
                      },
                      "includeWhen": {
                        "type": "string",
                        "required": false,
                        "pattern": "^\\$\\{[\\s\\S]+\\}\\s*$"
                      },
                      "targetPlane": {
                        "type": "string",
                        "required": false,
                        "default": "dataplane",
                        "enum": [
                          "dataplane",
                          "observabilityplane"
                        ]
                      },
                      "template": {
                        "type": "object",
                        "required": true,
                        "preserveUnknownFields": true
                      },
                      "var": {
                        "type": "string",
                        "required": false,
                        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                      }
                    }
                  }
                },
                "validations": {
                  "type": "array",
                  "required": false,
                  "items": {
                    "type": "object",
                    "properties": {
                      "message": {
                        "type": "string",
                        "required": true,
                        "minLength": 1
                      },
                      "rule": {
                        "type": "string",
                        "required": true,
                        "pattern": "^\\$\\{[\\s\\S]+\\}\\s*$"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "required": false
    }
  }
}
