{
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "required": true,
      "default": "openchoreo.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "required": true,
      "default": "SecretReference"
    },
    "metadata": {
      "type": "object",
      "required": false,
      "properties": {
        "annotations": {
          "type": "object",
          "required": false,
          "preserveUnknownFields": true
        },
        "creationTimestamp": {
          "type": "string",
          "required": false
        },
        "labels": {
          "type": "object",
          "required": false,
          "preserveUnknownFields": true
        },
        "name": {
          "type": "string",
          "required": false
        },
        "namespace": {
          "type": "string",
          "required": false
        },
        "uid": {
          "type": "string",
          "required": false
        }
      }
    },
    "spec": {
      "type": "object",
      "required": false,
      "properties": {
        "data": {
          "type": "array",
          "required": true,
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "remoteRef": {
                "type": "object",
                "required": true,
                "properties": {
                  "key": {
                    "type": "string",
                    "required": true,
                    "minLength": 1
                  },
                  "property": {
                    "type": "string",
                    "required": false
                  },
                  "version": {
                    "type": "string",
                    "required": false
                  }
                }
              },
              "secretKey": {
                "type": "string",
                "required": true,
                "minLength": 1
              }
            }
          }
        },
        "refreshInterval": {
          "type": "string",
          "required": false,
          "default": "1h"
        },
        "targetPlane": {
          "type": "object",
          "required": false,
          "properties": {
            "kind": {
              "type": "string",
              "required": true,
              "enum": [
                "WorkflowPlane",
                "ClusterWorkflowPlane",
                "DataPlane",
                "ClusterDataPlane"
              ]
            },
            "name": {
              "type": "string",
              "required": true,
              "minLength": 1
            }
          }
        },
        "template": {
          "type": "object",
          "required": true,
          "properties": {
            "metadata": {
              "type": "object",
              "required": false,
              "properties": {
                "annotations": {
                  "type": "object",
                  "required": false,
                  "preserveUnknownFields": true
                },
                "labels": {
                  "type": "object",
                  "required": false,
                  "preserveUnknownFields": true
                }
              }
            },
            "type": {
              "type": "string",
              "required": false,
              "default": "Opaque",
              "enum": [
                "Opaque",
                "kubernetes.io/dockerconfigjson",
                "kubernetes.io/dockercfg",
                "kubernetes.io/basic-auth",
                "kubernetes.io/ssh-auth",
                "kubernetes.io/tls",
                "bootstrap.kubernetes.io/token"
              ]
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "required": false,
      "properties": {
        "conditions": {
          "type": "array",
          "required": false,
          "items": {
            "type": "object",
            "properties": {
              "lastTransitionTime": {
                "type": "string",
                "required": false,
                "format": "date-time"
              },
              "message": {
                "type": "string",
                "required": false,
                "maxLength": 32768
              },
              "observedGeneration": {
                "type": "integer",
                "required": false,
                "format": "int64",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "required": false,
                "pattern": "^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$",
                "minLength": 1,
                "maxLength": 1024
              },
              "status": {
                "type": "string",
                "required": false,
                "enum": [
                  "True",
                  "False",
                  "Unknown"
                ]
              },
              "type": {
                "type": "string",
                "required": false,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$",
                "maxLength": 316
              }
            }
          }
        },
        "lastRefreshTime": {
          "type": "string",
          "required": false,
          "format": "date-time"
        },
        "secretStores": {
          "type": "array",
          "required": false,
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "required": true
              },
              "name": {
                "type": "string",
                "required": true
              },
              "namespace": {
                "type": "string",
                "required": true
              }
            }
          }
        }
      }
    }
  }
}
