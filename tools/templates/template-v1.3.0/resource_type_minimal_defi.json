                "type": "string",
                "required": true,
                "minLength": 1
              },
              "secretKeyRef": {
                "type": "object",
                "required": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "required": true,
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "required": true,
                    "minLength": 1
                  }
                }
