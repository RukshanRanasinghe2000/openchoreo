{
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "required": true,
      "default": "openchoreo.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "required": true,
      "default": "ClusterAuthzRoleBinding"
    },
    "metadata": {
      "type": "object",
      "required": false,
      "properties": {
        "annotations": {
          "type": "object",
          "required": false,
          "preserveUnknownFields": true
        },
        "creationTimestamp": {
          "type": "string",
          "required": false
        },
        "name": {
          "type": "string",
          "required": false
        },
        "uid": {
          "type": "string",
          "required": false
        }
      }
    },
    "spec": {
      "type": "object",
      "required": false,
      "properties": {
        "effect": {
          "type": "string",
          "required": false,
          "default": "allow",
          "enum": [
            "allow",
            "deny"
          ]
        },
        "entitlement": {
          "type": "object",
          "required": true,
          "properties": {
            "claim": {
              "type": "string",
              "required": true
            },
            "value": {
              "type": "string",
              "required": true
            }
          }
        },
        "roleMappings": {
          "type": "array",
          "required": true,
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "conditions": {
                "type": "array",
                "required": false,
                "items": {
                  "type": "object",
                  "properties": {
                    "actions": {
                      "type": "array",
                      "required": true,
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "expression": {
                      "type": "string",
                      "required": true,
                      "minLength": 1
                    }
                  }
                }
              },
              "roleRef": {
                "type": "object",
                "required": true,
                "properties": {
                  "kind": {
                    "type": "string",
                    "required": true,
                    "enum": [
                      "AuthzRole",
                      "ClusterAuthzRole"
                    ]
                  },
                  "name": {
                    "type": "string",
                    "required": true
                  }
                }
              },
              "scope": {
                "type": "object",
                "required": false,
                "properties": {
                  "component": {
                    "type": "string",
                    "required": false
                  },
                  "namespace": {
                    "type": "string",
                    "required": false
                  },
                  "project": {
                    "type": "string",
                    "required": false
                  },
                  "resource": {
                    "type": "string",
                    "required": false
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
