{
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "required": true,
      "default": "openchoreo.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "required": true,
      "default": "RenderedRelease"
    },
    "metadata": {
      "type": "object",
      "required": false,
      "properties": {
        "annotations": {
          "type": "object",
          "required": false,
          "preserveUnknownFields": true
        },
        "creationTimestamp": {
          "type": "string",
          "required": false
        },
        "labels": {
          "type": "object",
          "required": false,
          "preserveUnknownFields": true
        },
        "name": {
          "type": "string",
          "required": false
        },
        "namespace": {
          "type": "string",
          "required": false
        },
        "uid": {
          "type": "string",
          "required": false
        }
      }
    },
    "spec": {
      "type": "object",
      "required": false,
      "properties": {
        "environmentName": {
          "type": "string",
          "required": true,
          "minLength": 1
        },
        "interval": {
          "type": "string",
          "required": false,
          "pattern": "^([0-9]+(\\\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "owner": {
          "type": "object",
          "required": true,
          "properties": {
            "componentName": {
              "type": "string",
              "required": false
            },
            "projectName": {
              "type": "string",
              "required": true,
              "minLength": 1
            },
            "resourceName": {
              "type": "string",
              "required": false
            }
          }
        },
        "progressingInterval": {
          "type": "string",
          "required": false,
          "pattern": "^([0-9]+(\\\\.[0-9]+)?(ms|s|m|h))+$"
        },
        "resources": {
          "type": "array",
          "required": false,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "required": true,
                "minLength": 1
              },
              "object": {
                "type": "object",
                "required": true,
                "preserveUnknownFields": true
              }
            }
          }
        },
        "targetPlane": {
          "type": "string",
          "required": false,
          "default": "dataplane",
          "enum": [
            "dataplane",
            "observabilityplane"
          ]
        }
      }
    },
    "status": {
      "type": "object",
      "required": false,
      "properties": {
        "conditions": {
          "type": "array",
          "required": false,
          "items": {
            "type": "object",
            "properties": {
              "lastTransitionTime": {
                "type": "string",
                "required": false,
                "format": "date-time"
              },
              "message": {
                "type": "string",
                "required": false,
                "maxLength": 32768
              },
              "observedGeneration": {
                "type": "integer",
                "required": false,
                "format": "int64",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "required": false,
                "pattern": "^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$",
                "minLength": 1,
                "maxLength": 1024
              },
              "status": {
                "type": "string",
                "required": false,
                "enum": [
                  "True",
                  "False",
                  "Unknown"
                ]
              },
              "type": {
                "type": "string",
                "required": false,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$",
                "maxLength": 316
              }
            }
          }
        },
        "resources": {
          "type": "array",
          "required": false,
          "items": {
            "type": "object",
            "properties": {
              "group": {
                "type": "string",
                "required": false
              },
              "healthStatus": {
                "type": "string",
                "required": false,
                "enum": [
                  "Degraded",
                  "Healthy",
                  "Progressing",
                  "Suspended",
                  "Unknown"
                ]
              },
              "id": {
                "type": "string",
                "required": true,
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "required": true,
                "minLength": 1
              },
              "lastObservedTime": {
                "type": "string",
                "required": false,
                "format": "date-time"
              },
              "name": {
                "type": "string",
                "required": true,
                "minLength": 1
              },
              "namespace": {
                "type": "string",
                "required": false
              },
              "status": {
                "type": "object",
                "required": false,
                "preserveUnknownFields": true
              },
              "version": {
                "type": "string",
                "required": true,
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
