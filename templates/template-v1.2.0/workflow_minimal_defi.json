{
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string",
      "required": true,
      "default": "openchoreo.dev/v1alpha1"
    },
    "kind": {
      "type": "string",
      "required": true,
      "default": "Workflow"
    },
    "metadata": {
      "type": "object",
      "required": false,
      "properties": {
        "annotations": {
          "type": "object",
          "required": false,
          "preserveUnknownFields": true
        },
        "labels": {
          "type": "object",
          "required": false,
          "preserveUnknownFields": true
        },
        "name": {
          "type": "string",
          "required": false
        },
        "namespace": {
          "type": "string",
          "required": false
        }
      }
    },
    "spec": {
      "type": "object",
      "required": true,
      "properties": {
        "externalRefs": {
          "type": "array",
          "required": false,
          "items": {
            "type": "object",
            "properties": {
              "apiVersion": {
                "type": "string",
                "required": true,
                "minLength": 1
              },
              "id": {
                "type": "string",
                "required": true,
                "pattern": "^[a-z][a-z0-9-]*[a-z0-9]$",
                "minLength": 2,
                "maxLength": 63
              },
              "kind": {
                "type": "string",
                "required": true,
                "enum": [
                  "SecretReference"
                ]
              },
              "name": {
                "type": "string",
                "required": true,
                "minLength": 1
              }
            }
          }
        },
        "parameters": {
          "type": "object",
          "required": false,
          "properties": {
            "openAPIV3Schema": {
              "type": "object",
              "required": false,
              "preserveUnknownFields": true
            }
          }
        },
        "resources": {
          "type": "array",
          "required": false,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "required": true,
                "minLength": 1
              },
              "includeWhen": {
                "type": "string",
                "required": false,
                "pattern": "^\\$\\{[\\s\\S]+\\}\\s*$"
              },
              "template": {
                "type": "object",
                "required": true,
                "preserveUnknownFields": true
              }
            }
          }
        },
        "runTemplate": {
          "type": "object",
          "required": true,
          "preserveUnknownFields": true
        },
        "ttlAfterCompletion": {
          "type": "string",
          "required": false,
          "pattern": "^(\\d+d)?(\\d+h)?(\\d+m)?(\\d+s)?$"
        },
        "workflowPlaneRef": {
          "type": "object",
          "required": false,
          "default": {
            "kind": "ClusterWorkflowPlane",
            "name": "default"
          },
          "properties": {
            "kind": {
              "type": "string",
              "required": true,
              "enum": [
                "WorkflowPlane",
                "ClusterWorkflowPlane"
              ]
            },
            "name": {
              "type": "string",
              "required": true,
              "minLength": 1,
              "maxLength": 63
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "required": false,
      "properties": {
        "conditions": {
          "type": "array",
          "required": false,
          "items": {
            "type": "object",
            "properties": {
              "lastTransitionTime": {
                "type": "string",
                "required": false,
                "format": "date-time"
              },
              "message": {
                "type": "string",
                "required": false,
                "maxLength": 32768
              },
              "observedGeneration": {
                "type": "integer",
                "required": false,
                "format": "int64",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "required": false,
                "pattern": "^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$",
                "minLength": 1,
                "maxLength": 1024
              },
              "status": {
                "type": "string",
                "required": false,
                "enum": [
                  "True",
                  "False",
                  "Unknown"
                ]
              },
              "type": {
                "type": "string",
                "required": false,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$",
                "maxLength": 316
              }
            }
          }
        }
      }
    }
  }
}
